CODEX_SESSION_ID=
CODEX_MODEL=gpt-5.6-luna

# 飞书排班日历（自动巡检仅每天读取一次；当前暂停读取影刀消息群）
LARK_CLI_PS1=C:\Users\YOUR_NAME\AppData\Roaming\npm\lark-cli.ps1
YINGDAO_ROSTER_CALENDAR_ID=

# 排期重试预留，当前版本不连接
PYTASKGANTT_API_URL=

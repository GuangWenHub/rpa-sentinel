# 影刀公有云 OpenAPI
YINGDAO_API_BASE_URL=https://api.yingdao.com
YINGDAO_ACCESS_KEY_ID=
YINGDAO_ACCESS_KEY_SECRET=

# 本地 Codex：必须填写/初始化为 codex exec 专用会话，不能使用桌面或 IDE 会话 ID
